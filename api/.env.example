# Backend-only Scania Data Access credentials. Never use a VITE_ prefix.
SCANIA_CLIENT_ID=replace-with-scania-client-id
SCANIA_CLIENT_SECRET=replace-with-base64url-scania-client-secret
SCANIA_ACCESS_TOKEN=
SCANIA_AUTH_BASE_URL=https://dataaccess.scania.com/auth
SCANIA_CHALLENGE_URL=https://dataaccess.scania.com/auth/clientid2challenge
SCANIA_TOKEN_URL=https://dataaccess.scania.com/auth/response2token

# Supplied Scania API request URLs.
SCANIA_RFMS_VEHICLES_URL=https://dataaccess.scania.com/replace-with-vehicles-path
SCANIA_RFMS_VEHICLE_POSITIONS_URL=https://dataaccess.scania.com/replace-with-position-path
SCANIA_RFMS_VEHICLE_STATUSES_URL=https://dataaccess.scania.com/replace-with-status-path
SCANIA_LAST_REPORTED_POSITION_URL=
SCANIA_EXCEPTION_HISTORY_URL=https://dataaccess.scania.com/replace-with-exceptions-path
SCANIA_VEHICLE_EVALUATION_URL=https://dataaccess.scania.com/replace-with-vehicle-evaluation-path
SCANIA_VEHICLE_EVALUATION_GAS_URL=
SCANIA_VEHICLE_EVALUATION_GAS_QUERY_PARAM=includeGasConsumption
SCANIA_VEHICLE_EVALUATION_RESULT_URL=
SCANIA_DRIVER_EVALUATION_URL=
SCANIA_DRIVER_EVALUATION_V3_REQUEST_URL=
SCANIA_DRIVER_EVALUATION_V3_RESPONSE_URL=

# Reliability and asynchronous report polling.
SCANIA_HTTP_TIMEOUT_MS=20000
SCANIA_HTTP_RETRIES=1
SCANIA_MAX_PAGES=20
SCANIA_TOKEN_TTL_SECONDS=3600
SCANIA_REPORT_POLL_INTERVAL_MS=2000
SCANIA_REPORT_POLL_TIMEOUT_MS=60000
SCANIA_REPORT_SESSIONS_TABLE_NAME=ScaniaReportSessions
SCANIA_MASTER_TABLE_NAME=ScaniaVehicleMaster
SCANIA_STATE_TABLE_NAME=ScaniaVehicleState
SCANIA_POSITION_TABLE_NAME=ScaniaVehiclePosition
SCANIA_CURSOR_TABLE_NAME=ScaniaSyncCursor
SCANIA_SYNC_SECRET=
SCANIA_SYNC_INTERVAL_MS=300000
SCANIA_CACHE_SECONDS=60
SCANIA_STALE_AFTER_MINUTES=120
SCANIA_RUNNING_SPEED_KPH=3
EICHER_API_KEY=your_eicher_api_key

# Backend-only CASE Construction Equipment credentials. Never use a VITE_ prefix.
CASE_BASE_URL=https://api-data.cnh.com/v1/equipment
CASE_CUMULATIVE_OPERATING_HOURS_URL=https://api-data.cnh.com/v1/Fleet/Equipment/{vin}/CumulativeOperatingHours/{from}/{to}/1
CASE_CUMULATIVE_FUEL_USED_URL=https://api-data.cnh.com/v1/Fleet/Equipment/{vin}/CumulativeFuelUsed/{from}/{to}/1
CASE_CUMULATIVE_IDLE_HOURS_URL=https://api-data.cnh.com/v1/Fleet/Equipment/{vin}/CumulativeIdleHours/{from}/{to}/1
CASE_ACCESS_TOKEN=replace-with-current-case-bearer-token
CASE_SUBSCRIPTION_KEY=replace-with-case-apim-subscription-key
CASE_REQUEST_TIMEOUT_MS=20000
CASE_REQUEST_RETRIES=2
CASE_CACHE_SECONDS=60
CASE_REPORT_CACHE_SECONDS=300
CASE_METRIC_CONCURRENCY=8
CASE_MAX_METRIC_PAGES=100
CASE_REPORT_MAX_DAYS=31
